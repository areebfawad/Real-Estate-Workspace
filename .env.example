# All settings optional for local demo. No live email is sent until Resend is configured.
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
# Set COOKIE_SECURE=1 behind production HTTPS, or NODE_ENV=production.
COOKIE_SECURE=0
# Set TRUST_PROXY=1 ONLY behind a trusted reverse proxy.
TRUST_PROXY=0
# Optional live email notifications (Resend account + verified sending domain required).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
